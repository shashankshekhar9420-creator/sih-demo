# ==============================================================================
# SAHAJ (सहज) - Monorepo Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local or set these environment variables in your 
# deployment platform (e.g. Vercel, Railway, Render, Docker).
# Note: For local development, all variables have safe, working defaults.
# ==============================================================================

# Application URLs (Required in production for cross-app communication)
# ------------------------------------------------------------------------------
COMMERCE_APP_URL=http://localhost:3000
ARTISAN_APP_URL=http://localhost:4000

# Shared Server-to-Server API Security
# ------------------------------------------------------------------------------
# Secret key used by Artisan Studio to publish listings to Commerce app
DEMO_API_KEY=local-demo-key

# Commerce Demo Seller Authentication
# ------------------------------------------------------------------------------
DEMO_SELLER_ID=seller-demo
DEMO_SELLER_EMAIL=demo@sahaj-market.test
DEMO_SELLER_PASSWORD=demo123

# Session Security (CRITICAL: Change in production deployment!)
# ------------------------------------------------------------------------------
DEMO_SESSION_SECRET=sahaj-local-only-change-before-deployment-2026

# Database Note:
# SQLite database paths default to prisma/commerce.db and prisma/artisan.db
# No DATABASE_URL is required for standard SQLite operation.
